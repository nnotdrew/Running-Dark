{
  "name": "running-dark",
  "version": "0.1.0",
  "private": true,
  "description": "Driving routes that avoid ALPR cameras mapped in OpenStreetMap (DeFlock data).",
  "scripts": {
    "build": "node scripts/copy-vendor.mjs",
    "android:add": "npx cap add android && node scripts/patch-manifest.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "serve": "npx http-server www -p 8080 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app-launcher": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
